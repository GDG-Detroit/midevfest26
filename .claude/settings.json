{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm run *)",
      "Bash(pnpm install)",
      "Bash(pnpm install --frozen-lockfile)",
      "Bash(pnpm audit *)",
      "Bash(pnpm list *)",
      "Bash(pnpm outdated*)",
      "Bash(pnpm why *)",
      "Bash(pnpm exec *)",
      "Bash(pnpm --dir studio *)",
      "Bash(pnpm dlx *)",

      "Bash(node scripts/**)",
      "Bash(node --env-file=scripts/sanity-import/.env scripts/**)",

      "Bash(git status*)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(git branch*)",
      "Bash(git rev-list *)",
      "Bash(git check-ignore *)",
      "Bash(git ls-files*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git fetch *)",

      "Bash(gh repo view*)",
      "Bash(gh pr view*)",
      "Bash(gh pr diff*)",
      "Bash(gh api *)",

      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(echo *)",
      "Bash(pwd)",
      "Bash(find *)",
      "Bash(curl -s -o /dev/null *)",
      "Bash(pkill -f vite)",

      "Read(./**)"
    ],
    "deny": [
      "Read(./scripts/sanity-import/.env)",
      "Read(./**/*.pem)",
      "Read(./**/google-sa.json)",
      "Bash(npm install*)",
      "Bash(npm ci*)",
      "Bash(npm add*)"
    ],
    "defaultMode": "acceptEdits"
  }
}
